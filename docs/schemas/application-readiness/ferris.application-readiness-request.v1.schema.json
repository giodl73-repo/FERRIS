{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ferris:schema:application-readiness-request:v1",
  "title": "Ferris Application Readiness Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "application_id",
    "application_definition",
    "workspaces"
  ],
  "properties": {
    "schema": {
      "const": "ferris.application-readiness-request/v1"
    },
    "application_id": {
      "$ref": "#/$defs/portableId"
    },
    "application_definition": {
      "$ref": "#/$defs/applicationDefinition"
    },
    "workspaces": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/workspace"
      }
    }
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?:/[a-z0-9][a-z0-9._-]{0,63})+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativeFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "boundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativeFile"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "applicationDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!\\.\\.?$)[A-Za-z0-9._+-]+$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "manifest_path",
        "requirements_path",
        "requirements_digest"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/portableId"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1024,
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?:[A-Za-z0-9._+-]+/)*Cargo\\.toml$"
        },
        "requirements_path": {
          "$ref": "#/$defs/relativeFile"
        },
        "requirements_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
