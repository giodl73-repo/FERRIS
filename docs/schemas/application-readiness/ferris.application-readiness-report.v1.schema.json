{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ferris:schema:application-readiness-report:v1",
  "title": "Ferris Application Readiness Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "request_digest",
    "application_id",
    "composition_status",
    "diagnostic_code",
    "aggregate_status",
    "workspace_results",
    "unknowns",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "ferris.application-readiness-report/v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^application-readiness:[0-9a-f]{64}$"
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "application_id": {
      "$ref": "#/$defs/portableId"
    },
    "composition_status": {
      "enum": [
        "current",
        "stale"
      ]
    },
    "diagnostic_code": {
      "enum": [
        "FERRIS-APPLICATION-READINESS-CURRENT",
        "FERRIS-APPLICATION-READINESS-INPUT-STALE",
        "FERRIS-APPLICATION-READINESS-WORKSPACE-STALE"
      ]
    },
    "aggregate_status": {
      "$ref": "#/$defs/status"
    },
    "workspace_results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/workspaceResult"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 0
    },
    "limitations": {
      "const": [
        "FERRIS-APPLICATION-READINESS-WORKSPACE-ONLY"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "composition_status": {
            "const": "current"
          }
        },
        "required": [
          "composition_status"
        ]
      },
      "then": {
        "properties": {
          "diagnostic_code": {
            "enum": [
              "FERRIS-APPLICATION-READINESS-CURRENT",
              "FERRIS-APPLICATION-READINESS-WORKSPACE-STALE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "composition_status": {
            "const": "stale"
          }
        },
        "required": [
          "composition_status"
        ]
      },
      "then": {
        "properties": {
          "diagnostic_code": {
            "const": "FERRIS-APPLICATION-READINESS-INPUT-STALE"
          },
          "aggregate_status": {
            "const": "stale"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "diagnostic_code": {
            "const": "FERRIS-APPLICATION-READINESS-WORKSPACE-STALE"
          }
        },
        "required": [
          "diagnostic_code"
        ]
      },
      "then": {
        "properties": {
          "composition_status": {
            "const": "current"
          },
          "aggregate_status": {
            "const": "stale"
          }
        }
      }
    }
  ],
  "$defs": {
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "ready",
        "unsupported",
        "incomplete",
        "stale",
        "blocked"
      ]
    },
    "workspaceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "requirements_digest",
        "report_id",
        "aggregate_status"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/portableId"
        },
        "requirements_digest": {
          "$ref": "#/$defs/digest"
        },
        "report_id": {
          "type": "string",
          "pattern": "^report:[0-9a-f]{64}$"
        },
        "aggregate_status": {
          "$ref": "#/$defs/status"
        }
      }
    }
  }
}
