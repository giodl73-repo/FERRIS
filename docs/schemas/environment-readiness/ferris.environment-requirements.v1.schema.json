{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ferris:schema:environment-requirements:v1",
  "title": "Ferris Environment Requirements v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace_id",
    "declaration_id",
    "owner",
    "sources",
    "requirements"
  ],
  "properties": {
    "schema": {
      "const": "ferris.environment-requirements/v1"
    },
    "workspace_id": {
      "$ref": "#/$defs/workspaceId"
    },
    "declaration_id": {
      "$ref": "#/$defs/identifier"
    },
    "owner": {
      "$ref": "#/$defs/identifier"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workspaceRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\.|(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*)$"
    },
    "workspaceRelativeFilePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "operatingSystem": {
      "enum": [
        "windows",
        "linux",
        "macos"
      ]
    },
    "architecture": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_+-]*$"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_systems"
      ],
      "properties": {
        "operating_systems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operatingSystem"
          }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/architecture"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "claimed_authority",
        "interpretation"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "owner_declaration",
            "cargo_metadata",
            "rust_toolchain",
            "asdf_tool_versions",
            "mise",
            "devcontainer",
            "devfile",
            "documentation",
            "other"
          ]
        },
        "claimed_authority": {
          "$ref": "#/$defs/identifier"
        },
        "workspace_relative_path": {
          "$ref": "#/$defs/workspaceRelativeFilePath"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "interpretation": {
          "const": "declared_only"
        }
      }
    },
    "criticality": {
      "enum": [
        "required",
        "advisory"
      ]
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "platformExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_systems"
      ],
      "properties": {
        "operating_systems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operatingSystem"
          }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/architecture"
          }
        }
      }
    },
    "executableExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "resolution"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "resolution": {
          "const": "process_path"
        }
      }
    },
    "environmentExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        }
      }
    },
    "pathExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_relative_path",
        "path_kind"
      ],
      "properties": {
        "workspace_relative_path": {
          "$ref": "#/$defs/workspaceRelativePath"
        },
        "path_kind": {
          "enum": [
            "file",
            "directory"
          ]
        }
      }
    },
    "platformRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "kind",
        "criticality",
        "source_ids",
        "expectation"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "platform"
        },
        "criticality": {
          "$ref": "#/$defs/criticality"
        },
        "applies_to": {
          "$ref": "#/$defs/applicability"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "expectation": {
          "$ref": "#/$defs/platformExpectation"
        }
      }
    },
    "executableRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "kind",
        "criticality",
        "source_ids",
        "expectation"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "executable"
        },
        "criticality": {
          "$ref": "#/$defs/criticality"
        },
        "applies_to": {
          "$ref": "#/$defs/applicability"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "expectation": {
          "$ref": "#/$defs/executableExpectation"
        }
      }
    },
    "environmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "kind",
        "criticality",
        "source_ids",
        "expectation"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "environment"
        },
        "criticality": {
          "$ref": "#/$defs/criticality"
        },
        "applies_to": {
          "$ref": "#/$defs/applicability"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "expectation": {
          "$ref": "#/$defs/environmentExpectation"
        }
      }
    },
    "pathRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "kind",
        "criticality",
        "source_ids",
        "expectation"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "path"
        },
        "criticality": {
          "$ref": "#/$defs/criticality"
        },
        "applies_to": {
          "$ref": "#/$defs/applicability"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "expectation": {
          "$ref": "#/$defs/pathExpectation"
        }
      }
    },
    "requirement": {
      "oneOf": [
        {
          "$ref": "#/$defs/platformRequirement"
        },
        {
          "$ref": "#/$defs/executableRequirement"
        },
        {
          "$ref": "#/$defs/environmentRequirement"
        },
        {
          "$ref": "#/$defs/pathRequirement"
        }
      ]
    }
  }
}
