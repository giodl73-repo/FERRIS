{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ferris:schema:owner-entrypoint-intents:v1",
  "title": "Ferris Owner Entrypoint Intents v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entrypoints"
  ],
  "properties": {
    "schema": {
      "const": "ferris.owner-entrypoint-intents/v1"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/entrypoint"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "portable_file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^\\\\]+$"
    },
    "portable_directory": {
      "anyOf": [
        {
          "const": "."
        },
        {
          "$ref": "#/$defs/portable_file"
        }
      ]
    },
    "environment_name": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint_id",
        "owner",
        "executable",
        "argv",
        "working_directory",
        "inherited_environment",
        "credential_class",
        "bound_files"
      ],
      "properties": {
        "entrypoint_id": {
          "$ref": "#/$defs/metadata"
        },
        "owner": {
          "$ref": "#/$defs/metadata"
        },
        "executable": {
          "$ref": "#/$defs/portable_file"
        },
        "argv": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "working_directory": {
          "$ref": "#/$defs/portable_directory"
        },
        "inherited_environment": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/environment_name"
          }
        },
        "credential_class": {
          "const": "none"
        },
        "bound_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/portable_file"
          }
        }
      }
    }
  }
}
