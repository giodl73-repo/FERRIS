{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ferris:schema:owner-validation-domains:v1",
  "title": "Ferris Owner Validation Domains v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace_id",
    "domains"
  ],
  "properties": {
    "schema": {
      "const": "ferris.owner-validation-domains/v1"
    },
    "workspace_id": {
      "$ref": "#/$defs/workspaceId"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "$defs": {
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "path_prefix",
        "entrypoint_ids"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/ownerId"
        },
        "path_prefix": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ownerId"
          }
        }
      }
    }
  }
}
