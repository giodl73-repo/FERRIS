{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ferris:schema:owner-validation-domains:v2",
  "title": "Ferris Owner Validation Domains v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace_id",
    "domains"
  ],
  "properties": {
    "schema": {
      "const": "ferris.owner-validation-domains/v2"
    },
    "workspace_id": {
      "$ref": "#/$defs/workspaceId"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "$defs": {
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "workspaceRelativeDirectory": {
      "type": "string",
      "minLength": 1
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preparation_id",
        "working_directory"
      ],
      "properties": {
        "preparation_id": {
          "$ref": "#/$defs/ownerId"
        },
        "working_directory": {
          "$ref": "#/$defs/workspaceRelativeDirectory"
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint_id",
        "breadth",
        "preparation"
      ],
      "properties": {
        "entrypoint_id": {
          "$ref": "#/$defs/ownerId"
        },
        "breadth": {
          "enum": [
            "focused",
            "subsystem",
            "comprehensive"
          ]
        },
        "preparation": {
          "$ref": "#/$defs/preparation"
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "path_prefix",
        "entrypoints"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/ownerId"
        },
        "path_prefix": {
          "type": "string",
          "minLength": 1
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entrypoint"
          }
        }
      }
    }
  }
}
