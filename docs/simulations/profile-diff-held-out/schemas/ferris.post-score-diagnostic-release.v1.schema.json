{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferris.invalid/schemas/ferris.post-score-diagnostic-release.v1.schema.json",
  "title": "Ferris post-score diagnostic release receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_identity",
    "release_id",
    "program_id",
    "precommitted_tier",
    "failure_category",
    "original_result",
    "custody",
    "reproducer",
    "environments",
    "equivalence",
    "bounds",
    "lifecycle",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "ferris.post-score-diagnostic-release/v1" },
    "receipt_identity": { "$ref": "#/$defs/digest" },
    "release_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "program_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "precommitted_tier": { "const": "sanitized-reproducer" },
    "failure_category": { "type": "string", "minLength": 1, "maxLength": 128 },
    "original_result": { "$ref": "#/$defs/originalResult" },
    "custody": { "$ref": "#/$defs/custody" },
    "reproducer": { "$ref": "#/$defs/reproducer" },
    "environments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/environment" }
    },
    "equivalence": { "$ref": "#/$defs/equivalence" },
    "bounds": { "$ref": "#/$defs/bounds" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "originalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest", "immutable", "score_attempt", "scorer_attempt"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "immutable": { "const": true },
        "score_attempt": { "const": 1 },
        "scorer_attempt": { "const": 1 }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent",
        "original_fixture_retired",
        "original_fixture_reused",
        "hidden_canary_hits",
        "private_identifier_hits",
        "private_digest_hits",
        "byte_identical_hidden_inputs",
        "sealed_changed_path_hits",
        "oracle_detail_hits"
      ],
      "properties": {
        "independent": { "const": true },
        "original_fixture_retired": { "const": true },
        "original_fixture_reused": { "const": false },
        "hidden_canary_hits": { "const": 0 },
        "private_identifier_hits": { "const": 0 },
        "private_digest_hits": { "const": 0 },
        "byte_identical_hidden_inputs": { "const": 0 },
        "sealed_changed_path_hits": { "const": 0 },
        "oracle_detail_hits": { "const": 0 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "digest"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "reproducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_root", "files", "commands"],
      "properties": {
        "public_root": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/file" }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/command" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "command_digest", "actual_exit", "category_reproduced"],
      "properties": {
        "platform": { "enum": ["windows-x86_64", "ubuntu-24.04-wsl2-x86_64"] },
        "command_digest": { "$ref": "#/$defs/digest" },
        "actual_exit": { "type": "integer", "minimum": 0, "maximum": 255 },
        "category_reproduced": { "const": true }
      }
    },
    "equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_matches", "exit_matches", "platforms_complete"],
      "properties": {
        "category_matches": { "const": true },
        "exit_matches": { "const": true },
        "platforms_complete": { "const": true }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regular_files", "total_bytes", "commands_per_platform", "timeout_millis", "stdout_max_bytes", "stderr_max_bytes"],
      "properties": {
        "regular_files": { "type": "integer", "minimum": 1, "maximum": 16 },
        "total_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "commands_per_platform": { "type": "integer", "minimum": 1, "maximum": 4 },
        "timeout_millis": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "stdout_max_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "stderr_max_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published", "cleanup_complete", "original_future_certification_eligible", "reproducer_future_certification_eligible", "replacement_package_required"],
      "properties": {
        "published": { "const": true },
        "cleanup_complete": { "const": true },
        "original_future_certification_eligible": { "const": false },
        "reproducer_future_certification_eligible": { "const": false },
        "replacement_package_required": { "const": true }
      }
    }
  }
}
