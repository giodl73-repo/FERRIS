{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ferris:schema:profile-diff-collection-row:v1",
  "title": "Ferris Profile Diff Collection Row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "collection_id",
    "row_identity",
    "declaration",
    "expected",
    "executable",
    "command",
    "current_directory",
    "environment_digest",
    "environment_allowlist",
    "started_at",
    "completed_at",
    "duration_millis",
    "launch",
    "stdout",
    "stderr",
    "process_exit_code"
  ],
  "properties": {
    "schema": {
      "const": "ferris.profile-diff-collection-row/v1"
    },
    "collection_id": {
      "$ref": "#/$defs/identifier"
    },
    "row_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "declaration": {
      "$ref": "#/$defs/declaration"
    },
    "expected": {
      "$ref": "#/$defs/expected"
    },
    "executable": {
      "$ref": "#/$defs/executable"
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "current_directory": {
      "type": "string",
      "minLength": 1
    },
    "environment_digest": {
      "$ref": "#/$defs/digest"
    },
    "environment_allowlist": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/environmentEntry"
      }
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "duration_millis": {
      "type": "integer",
      "minimum": 0
    },
    "launch": {
      "$ref": "#/$defs/launch"
    },
    "stdout": {
      "$ref": "#/$defs/stream"
    },
    "stderr": {
      "$ref": "#/$defs/stream"
    },
    "process_exit_code": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "launch": {
            "properties": {
              "status": {
                "const": "started"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "process_exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "launch": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "process_exit_code": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "resultClass": {
      "enum": [
        "success",
        "difference",
        "invalid",
        "unsupported",
        "incomplete",
        "blocked",
        "internal"
      ]
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_case_id",
        "case_number",
        "case_class",
        "platform",
        "format",
        "attempt"
      ],
      "properties": {
        "declared_case_id": {
          "$ref": "#/$defs/identifier"
        },
        "case_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 56
        },
        "case_class": {
          "enum": [
            "result-section-semantics",
            "structural-pointer-behavior",
            "strict-validation-classification",
            "explicit-input-resource-bounds",
            "identity-privacy-process-boundary"
          ]
        },
        "platform": {
          "enum": [
            "windows-x86_64",
            "unix-x86_64"
          ]
        },
        "format": {
          "enum": [
            "json",
            "human"
          ]
        },
        "attempt": {
          "const": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_launch",
        "allowed_result_classes",
        "allowed_exit_codes",
        "selected_stream"
      ],
      "properties": {
        "must_launch": {
          "const": true
        },
        "allowed_result_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resultClass"
          }
        },
        "allowed_exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              0,
              1,
              2,
              4,
              5,
              7,
              11
            ]
          }
        },
        "selected_stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size_bytes"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "digest"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "environmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "error_class",
        "error_digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "started",
            "failed"
          ]
        },
        "error_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "started"
              }
            }
          },
          "then": {
            "properties": {
              "error_class": {
                "type": "null"
              },
              "error_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error_class": {
                "type": "string",
                "minLength": 1
              },
              "error_digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      ]
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_path",
        "byte_count",
        "digest",
        "complete",
        "truncated"
      ],
      "properties": {
        "capture_path": {
          "type": "string",
          "minLength": 1
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "complete": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
