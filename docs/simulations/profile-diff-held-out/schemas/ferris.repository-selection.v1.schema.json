{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ferris:schema:repository-selection:v1",
  "title": "Ferris Repository Selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_identity",
    "workflow_id",
    "slot",
    "repository_url",
    "commit",
    "manifest_path",
    "lockfile_path",
    "packages",
    "feature_mode",
    "features",
    "host_target",
    "cross_target",
    "native_prerequisites",
    "license_evidence",
    "license_evidence_digest",
    "eligibility",
    "eligibility_evidence_digest",
    "workflow_bounds",
    "execution_policy",
    "owner_command_templates",
    "change_policy",
    "selected_at"
  ],
  "properties": {
    "schema": {
      "const": "ferris.repository-selection/v1"
    },
    "receipt_identity": {
      "$ref": "#/$defs/digest"
    },
    "workflow_id": {
      "$ref": "#/$defs/identifier"
    },
    "slot": {
      "$ref": "#/$defs/slot"
    },
    "repository_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "manifest_path": {
      "$ref": "#/$defs/relativePath"
    },
    "lockfile_path": {
      "$ref": "#/$defs/relativePath"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/packageName"
      }
    },
    "feature_mode": {
      "enum": [
        "default",
        "all-features",
        "no-default-features",
        "selected-no-default-features"
      ]
    },
    "features": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "host_target": {
      "$ref": "#/$defs/targetTriple"
    },
    "cross_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_prerequisites": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/nativePrerequisite"
      }
    },
    "license_evidence": {
      "$ref": "#/$defs/licenseEvidence"
    },
    "license_evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "eligibility": {
      "$ref": "#/$defs/eligibility"
    },
    "eligibility_evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "workflow_bounds": {
      "$ref": "#/$defs/workflowBounds"
    },
    "execution_policy": {
      "$ref": "#/$defs/executionPolicy"
    },
    "owner_command_templates": {
      "$ref": "#/$defs/phaseCommands"
    },
    "change_policy": {
      "$ref": "#/$defs/changePolicy"
    },
    "selected_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "slot": {
            "const": "cross_target_no_std"
          }
        }
      },
      "then": {
        "properties": {
          "packages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          },
          "cross_target": {
            "$ref": "#/$defs/targetTriple"
          },
          "owner_command_templates": {
            "$ref": "#/$defs/phaseCommandsTwo"
          },
          "native_prerequisites": {
            "maxItems": 0
          },
          "change_policy": {
            "properties": {
              "category": {
                "const": "target-conditional-behavior"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "slot": {
            "const": "native_bound"
          }
        }
      },
      "then": {
        "properties": {
          "packages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          },
          "native_prerequisites": {
            "minItems": 1
          },
          "owner_command_templates": {
            "$ref": "#/$defs/phaseCommandsOne"
          },
          "cross_target": {
            "type": "null"
          },
          "change_policy": {
            "properties": {
              "category": {
                "const": "native-boundary-behavior"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "slot": {
            "const": "hosted"
          }
        }
      },
      "then": {
        "properties": {
          "owner_command_templates": {
            "$ref": "#/$defs/phaseCommandsOne"
          },
          "cross_target": {
            "type": "null"
          },
          "native_prerequisites": {
            "maxItems": 0
          },
          "change_policy": {
            "properties": {
              "category": {
                "const": "hosted-observable-behavior"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "feature_mode": {
            "enum": [
              "default",
              "all-features",
              "no-default-features"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "features": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "feature_mode": {
            "const": "selected-no-default-features"
          }
        }
      },
      "then": {
        "properties": {
          "features": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "slot": {
      "enum": [
        "hosted",
        "cross_target_no_std",
        "native_bound"
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "packageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "targetTriple": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "nativePrerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "evidence_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "licenseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "spdx_expression",
        "license_files",
        "source_url"
      ],
      "properties": {
        "conclusion": {
          "const": "permits-temporary-local-validation"
        },
        "spdx_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "source_url": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidenceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "satisfied",
        "evidence_digest"
      ],
      "properties": {
        "satisfied": {
          "const": true
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_https",
        "committed_lockfile",
        "clean_detached_checkout",
        "baseline_passed",
        "full_reference_passed",
        "offline_owner_commands",
        "no_reusable_secrets",
        "no_account",
        "no_live_service",
        "no_privileged_operation",
        "no_package_installation",
        "no_container_daemon",
        "no_mutable_external_system",
        "within_command_bounds",
        "no_submodules",
        "no_git_lfs",
        "no_generated_credentials",
        "no_network_at_test",
        "ordinary_cargo_preserved",
        "reversible_source_only_change",
        "independent_selection",
        "not_implementation_author_fork",
        "not_previously_used_to_tune_ferris",
        "hidden_change_independent"
      ],
      "properties": {
        "public_https": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "committed_lockfile": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "clean_detached_checkout": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "baseline_passed": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "full_reference_passed": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "offline_owner_commands": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_reusable_secrets": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_account": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_live_service": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_privileged_operation": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_package_installation": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_container_daemon": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_mutable_external_system": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "within_command_bounds": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_submodules": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_git_lfs": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_generated_credentials": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "no_network_at_test": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "ordinary_cargo_preserved": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "reversible_source_only_change": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "independent_selection": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "not_implementation_author_fork": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "not_previously_used_to_tune_ferris": {
          "$ref": "#/$defs/evidenceAssertion"
        },
        "hidden_change_independent": {
          "$ref": "#/$defs/evidenceAssertion"
        }
      }
    },
    "workflowBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_count",
        "phase_count",
        "sealed_change_count",
        "source_files_per_patch",
        "patch_min_bytes",
        "patch_max_bytes",
        "checkout_regular_files_max",
        "checkout_bytes_max",
        "owner_command_timeout_millis",
        "stdout_max_bytes",
        "stderr_max_bytes",
        "environment_allowlist_max_entries",
        "environment_value_max_bytes",
        "command_attempts",
        "network_requests_after_materialization"
      ],
      "properties": {
        "repository_count": {
          "const": 3
        },
        "phase_count": {
          "const": 7
        },
        "sealed_change_count": {
          "const": 3
        },
        "source_files_per_patch": {
          "const": 1
        },
        "patch_min_bytes": {
          "const": 1
        },
        "patch_max_bytes": {
          "const": 16384
        },
        "checkout_regular_files_max": {
          "const": 100000
        },
        "checkout_bytes_max": {
          "const": 2147483648
        },
        "owner_command_timeout_millis": {
          "const": 900000
        },
        "stdout_max_bytes": {
          "const": 1048576
        },
        "stderr_max_bytes": {
          "const": 1048576
        },
        "environment_allowlist_max_entries": {
          "const": 32
        },
        "environment_value_max_bytes": {
          "const": 4096
        },
        "command_attempts": {
          "const": 1
        },
        "network_requests_after_materialization": {
          "const": 0
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_after_materialization",
        "cargo_net_offline",
        "rustup_auto_install",
        "external_target_directories",
        "unique_target_per_phase_command",
        "shared_compilation_cache",
        "rustc_wrapper",
        "rustc_workspace_wrapper",
        "locale",
        "shell_recorded",
        "argv_reinterpreted_by_shell"
      ],
      "properties": {
        "offline_after_materialization": {
          "const": true
        },
        "cargo_net_offline": {
          "const": true
        },
        "rustup_auto_install": {
          "const": false
        },
        "external_target_directories": {
          "const": true
        },
        "unique_target_per_phase_command": {
          "const": true
        },
        "shared_compilation_cache": {
          "const": false
        },
        "rustc_wrapper": {
          "type": "null"
        },
        "rustc_workspace_wrapper": {
          "type": "null"
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "shell_recorded": {
          "const": true
        },
        "argv_reinterpreted_by_shell": {
          "const": false
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "commandList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/argv"
      }
    },
    "oneCommandList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/argv"
      }
    },
    "twoCommandList": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/argv"
      }
    },
    "phaseCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "changed",
        "full_reference",
        "renewal",
        "rollback",
        "removal",
        "cleanup"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/commandList"
        },
        "changed": {
          "$ref": "#/$defs/commandList"
        },
        "full_reference": {
          "$ref": "#/$defs/commandList"
        },
        "renewal": {
          "$ref": "#/$defs/commandList"
        },
        "rollback": {
          "$ref": "#/$defs/commandList"
        },
        "removal": {
          "$ref": "#/$defs/commandList"
        },
        "cleanup": {
          "$ref": "#/$defs/commandList"
        }
      }
    },
    "phaseCommandsOne": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "changed",
        "full_reference",
        "renewal",
        "rollback",
        "removal",
        "cleanup"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/oneCommandList"
        },
        "changed": {
          "$ref": "#/$defs/oneCommandList"
        },
        "full_reference": {
          "$ref": "#/$defs/oneCommandList"
        },
        "renewal": {
          "$ref": "#/$defs/oneCommandList"
        },
        "rollback": {
          "$ref": "#/$defs/oneCommandList"
        },
        "removal": {
          "$ref": "#/$defs/oneCommandList"
        },
        "cleanup": {
          "$ref": "#/$defs/oneCommandList"
        }
      }
    },
    "phaseCommandsTwo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "changed",
        "full_reference",
        "renewal",
        "rollback",
        "removal",
        "cleanup"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/twoCommandList"
        },
        "changed": {
          "$ref": "#/$defs/twoCommandList"
        },
        "full_reference": {
          "$ref": "#/$defs/twoCommandList"
        },
        "renewal": {
          "$ref": "#/$defs/twoCommandList"
        },
        "rollback": {
          "$ref": "#/$defs/twoCommandList"
        },
        "removal": {
          "$ref": "#/$defs/twoCommandList"
        },
        "cleanup": {
          "$ref": "#/$defs/twoCommandList"
        }
      }
    },
    "changePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "logical_changes",
        "modified_regular_utf8_rust_files",
        "added_paths",
        "deleted_paths",
        "patch_min_bytes",
        "patch_max_bytes"
      ],
      "properties": {
        "category": {
          "enum": [
            "hosted-observable-behavior",
            "target-conditional-behavior",
            "native-boundary-behavior"
          ]
        },
        "logical_changes": {
          "const": 1
        },
        "modified_regular_utf8_rust_files": {
          "const": 1
        },
        "added_paths": {
          "const": 0
        },
        "deleted_paths": {
          "const": 0
        },
        "patch_min_bytes": {
          "const": 1
        },
        "patch_max_bytes": {
          "const": 16384
        }
      }
    }
  }
}
