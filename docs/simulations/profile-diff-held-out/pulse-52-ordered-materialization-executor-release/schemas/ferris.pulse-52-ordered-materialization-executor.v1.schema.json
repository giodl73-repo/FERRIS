{
  "$id": "urn:ferris:schema:pulse-52-ordered-materialization-executor:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identifier": {
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "type": "string"
    },
    "validationEvent": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "public-artifact-self-validation"
        },
        "completed_checks": {
          "minimum": 0,
          "type": "integer"
        },
        "event_kind": {
          "const": "validation-complete"
        },
        "expected_checks": {
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "const": "ferris.pulse-43-ordered-result-event/v1"
        },
        "validation_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "classification",
        "completed_checks",
        "event_kind",
        "expected_checks",
        "schema",
        "validation_id"
      ],
      "type": "object"
    },
    "executionEvent": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "ordered-execution"
        },
        "event_kind": {
          "enum": [
            "gate-complete",
            "terminal-stop"
          ]
        },
        "gate_id": {
          "$ref": "#/$defs/identifier"
        },
        "outcome": {
          "enum": [
            "passed",
            "completed",
            "failed",
            "stopped"
          ]
        },
        "schema": {
          "const": "ferris.pulse-43-ordered-result-event/v1"
        }
      },
      "required": [
        "classification",
        "event_kind",
        "gate_id",
        "outcome",
        "schema"
      ],
      "type": "object"
    },
    "terminalPublication": {
      "additionalProperties": false,
      "properties": {
        "category_conclusion": {
          "type": "null"
        },
        "disposition": {
          "enum": [
            "not-attempted",
            "published",
            "invalid-publication-integrity"
          ]
        },
        "fix_conclusion": {
          "type": "null"
        },
        "posture": {
          "type": "object"
        },
        "product_conclusion": {
          "type": "null"
        },
        "schema": {
          "const": "ferris.pulse-52-terminal-publication-disposition/v1"
        }
      },
      "required": [
        "category_conclusion",
        "disposition",
        "fix_conclusion",
        "posture",
        "product_conclusion",
        "schema"
      ],
      "type": "object"
    },
    "terminalCleanupIndeterminate": {
      "$comment": "This is the public_posture on the non-returning TerminalPublicationCleanupIndeterminate fatal error, never a completed public return.",
      "additionalProperties": false,
      "properties": {
        "cleanup_owner": {
          "const": "caller-public-custodian"
        },
        "cleanup_posture": {
          "const": "unresolved"
        },
        "schema": {
          "const": "ferris.pulse-52-terminal-publication-cleanup-indeterminate/v1"
        },
        "state": {
          "const": "terminal-publication-cleanup-indeterminate"
        }
      },
      "required": [
        "cleanup_owner",
        "cleanup_posture",
        "schema",
        "state"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "additionalProperties": false,
      "properties": {
        "gate_ids": {
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "schema": {
          "const": "ferris.pulse-43-ordered-gate-catalog/v1"
        }
      },
      "required": [
        "gate_ids",
        "schema"
      ],
      "type": "object"
    },
    "events": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/validationEvent"
          },
          {
            "$ref": "#/$defs/executionEvent"
          }
        ]
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "publication": {
      "$ref": "#/$defs/terminalPublication"
    },
    "schema": {
      "const": "ferris.pulse-52-ordered-materialization-executor-public-return/v1"
    }
  },
  "required": [
    "catalog",
    "events",
    "publication",
    "schema"
  ],
  "type": "object"
}
