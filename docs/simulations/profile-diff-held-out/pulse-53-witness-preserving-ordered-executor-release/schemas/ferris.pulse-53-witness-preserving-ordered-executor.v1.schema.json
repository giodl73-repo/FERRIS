{
  "$id": "urn:ferris:schema:pulse-53-witness-preserving-ordered-executor:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "type": "string"
    },
    "validationEvent": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "public-artifact-self-validation"
        },
        "completed_checks": {
          "minimum": 0,
          "type": "integer"
        },
        "event_kind": {
          "const": "validation-complete"
        },
        "expected_checks": {
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "const": "ferris.pulse-43-ordered-result-event/v1"
        },
        "validation_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "classification",
        "completed_checks",
        "event_kind",
        "expected_checks",
        "schema",
        "validation_id"
      ],
      "type": "object"
    },
    "executionEvent": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "ordered-execution"
        },
        "event_kind": {
          "enum": [
            "gate-complete",
            "terminal-stop"
          ]
        },
        "gate_id": {
          "$ref": "#/$defs/identifier"
        },
        "outcome": {
          "enum": [
            "passed",
            "completed",
            "failed",
            "stopped"
          ]
        },
        "schema": {
          "const": "ferris.pulse-43-ordered-result-event/v1"
        }
      },
      "required": [
        "classification",
        "event_kind",
        "gate_id",
        "outcome",
        "schema"
      ],
      "type": "object"
    },
    "hashes": {
      "additionalProperties": false,
      "properties": {
        "receipt_payload_sha256": {
          "$ref": "#/$defs/digest"
        },
        "receipt_raw_sha256": {
          "$ref": "#/$defs/digest"
        },
        "result_payload_sha256": {
          "$ref": "#/$defs/digest"
        },
        "result_raw_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "receipt_payload_sha256",
        "receipt_raw_sha256",
        "result_payload_sha256",
        "result_raw_sha256"
      ],
      "type": "object"
    },
    "witnessHashes": {
      "additionalProperties": false,
      "properties": {
        "receipt_payload_sha256": {
          "$ref": "#/$defs/digest"
        },
        "receipt_raw_sha256": {
          "$ref": "#/$defs/digest"
        },
        "witness_payload_sha256": {
          "$ref": "#/$defs/digest"
        },
        "witness_raw_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "receipt_payload_sha256",
        "receipt_raw_sha256",
        "witness_payload_sha256",
        "witness_raw_sha256"
      ],
      "type": "object"
    },
    "resultAndWitnessDescriptor": {
      "additionalProperties": false,
      "properties": {
        "exact_file_counts": {
          "const": {
            "result": 2,
            "total": 4,
            "witness": 2
          }
        },
        "expected_public_tree_kind": {
          "const": "result-and-witness"
        },
        "schema": {
          "const": "ferris.pulse-53-public-transfer-descriptor/v1"
        },
        "verified_raw_payload_hashes": {
          "additionalProperties": false,
          "properties": {
            "result": {
              "$ref": "#/$defs/hashes"
            },
            "witness": {
              "$ref": "#/$defs/witnessHashes"
            }
          },
          "required": [
            "result",
            "witness"
          ],
          "type": "object"
        }
      },
      "required": [
        "exact_file_counts",
        "expected_public_tree_kind",
        "schema",
        "verified_raw_payload_hashes"
      ],
      "type": "object"
    },
    "failureWitnessDescriptor": {
      "additionalProperties": false,
      "properties": {
        "exact_file_counts": {
          "const": {
            "total": 2,
            "witness": 2
          }
        },
        "expected_public_tree_kind": {
          "const": "failure-witness-only"
        },
        "schema": {
          "const": "ferris.pulse-53-public-transfer-descriptor/v1"
        },
        "verified_raw_payload_hashes": {
          "additionalProperties": false,
          "properties": {
            "witness": {
              "$ref": "#/$defs/witnessHashes"
            }
          },
          "required": [
            "witness"
          ],
          "type": "object"
        }
      },
      "required": [
        "exact_file_counts",
        "expected_public_tree_kind",
        "schema",
        "verified_raw_payload_hashes"
      ],
      "type": "object"
    },
    "terminalPublication": {
      "additionalProperties": false,
      "properties": {
        "category_conclusion": {
          "type": "null"
        },
        "disposition": {
          "enum": [
            "not-attempted",
            "published-result",
            "published-failure-witness",
            "invalid-witness-publication"
          ]
        },
        "fix_conclusion": {
          "type": "null"
        },
        "posture": {
          "type": "object"
        },
        "product_conclusion": {
          "type": "null"
        },
        "schema": {
          "const": "ferris.pulse-53-terminal-publication-disposition/v1"
        }
      },
      "required": [
        "category_conclusion",
        "disposition",
        "fix_conclusion",
        "posture",
        "product_conclusion",
        "schema"
      ],
      "type": "object"
    },
    "terminalCleanupIndeterminate": {
      "$comment": "Public posture of the non-returning cleanup fatal state, never a completed return.",
      "additionalProperties": false,
      "properties": {
        "cleanup_owner": {
          "const": "caller-public-custodian"
        },
        "cleanup_posture": {
          "const": "unresolved"
        },
        "schema": {
          "const": "ferris.pulse-53-terminal-publication-cleanup-indeterminate/v1"
        },
        "state": {
          "const": "terminal-publication-cleanup-indeterminate"
        }
      },
      "required": [
        "cleanup_owner",
        "cleanup_posture",
        "schema",
        "state"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "additionalProperties": false,
      "properties": {
        "gate_ids": {
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "schema": {
          "const": "ferris.pulse-43-ordered-gate-catalog/v1"
        }
      },
      "required": [
        "gate_ids",
        "schema"
      ],
      "type": "object"
    },
    "events": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/validationEvent"
          },
          {
            "$ref": "#/$defs/executionEvent"
          }
        ]
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "publication": {
      "$ref": "#/$defs/terminalPublication"
    },
    "schema": {
      "const": "ferris.pulse-53-witness-preserving-ordered-executor-public-return/v1"
    },
    "transfer_descriptor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/resultAndWitnessDescriptor"
        },
        {
          "$ref": "#/$defs/failureWitnessDescriptor"
        }
      ]
    }
  },
  "required": [
    "catalog",
    "events",
    "publication",
    "schema",
    "transfer_descriptor"
  ],
  "type": "object"
}
