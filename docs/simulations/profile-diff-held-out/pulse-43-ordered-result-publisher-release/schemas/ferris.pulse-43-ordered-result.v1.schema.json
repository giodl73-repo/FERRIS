{"$id":"https://ferris.example/schemas/ferris.pulse-43-ordered-result.v1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"catalog":{"additionalProperties":false,"properties":{"gate_ids":{"items":{"$ref":"#/$defs/publicIdentifier"},"maxItems":24,"minItems":1,"type":"array","uniqueItems":true},"schema":{"const":"ferris.pulse-43-ordered-gate-catalog/v1"}},"required":["schema","gate_ids"],"type":"object"},"execution":{"additionalProperties":false,"properties":{"classification":{"const":"ordered-execution"},"event_kind":{"enum":["gate-complete","terminal-stop"]},"gate_id":{"$ref":"#/$defs/publicIdentifier"},"outcome":{"enum":["passed","completed","failed","stopped"]},"schema":{"const":"ferris.pulse-43-ordered-result-event/v1"}},"required":["schema","classification","event_kind","gate_id","outcome"],"type":"object"},"publicIdentifier":{"maxLength":48,"pattern":"^[a-z][a-z0-9-]{0,47}$","type":"string"},"validation":{"additionalProperties":false,"properties":{"classification":{"const":"public-artifact-self-validation"},"completed_checks":{"maximum":1000000,"minimum":0,"type":"integer"},"event_kind":{"const":"validation-complete"},"expected_checks":{"maximum":1000000,"minimum":0,"type":"integer"},"schema":{"const":"ferris.pulse-43-ordered-result-event/v1"},"validation_id":{"$ref":"#/$defs/publicIdentifier"}},"required":["schema","classification","event_kind","validation_id","completed_checks","expected_checks"],"type":"object"}},"additionalProperties":false,"properties":{"catalog":{"$ref":"#/$defs/catalog"},"events":{"items":{"oneOf":[{"$ref":"#/$defs/validation"},{"$ref":"#/$defs/execution"}]},"maxItems":128,"minItems":1,"type":"array"}},"required":["catalog","events"],"title":"Pulse 43 ordered public-result controls","type":"object"}
