{
  "$id": "urn:ferris:schema:pulse-51-diagnostic-executor:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identifier": {
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "type": "string"
    },
    "validationEvent": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "public-artifact-self-validation"
        },
        "completed_checks": {
          "minimum": 0,
          "type": "integer"
        },
        "event_kind": {
          "const": "validation-complete"
        },
        "expected_checks": {
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "const": "ferris.pulse-43-ordered-result-event/v1"
        },
        "validation_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "classification",
        "completed_checks",
        "event_kind",
        "expected_checks",
        "schema",
        "validation_id"
      ],
      "type": "object"
    },
    "executionEvent": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "ordered-execution"
        },
        "event_kind": {
          "enum": [
            "gate-complete",
            "terminal-stop"
          ]
        },
        "gate_id": {
          "$ref": "#/$defs/identifier"
        },
        "outcome": {
          "enum": [
            "passed",
            "completed",
            "failed",
            "stopped"
          ]
        },
        "schema": {
          "const": "ferris.pulse-43-ordered-result-event/v1"
        }
      },
      "required": [
        "classification",
        "event_kind",
        "gate_id",
        "outcome",
        "schema"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "additionalProperties": false,
      "properties": {
        "gate_ids": {
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "schema": {
          "const": "ferris.pulse-43-ordered-gate-catalog/v1"
        }
      },
      "required": [
        "gate_ids",
        "schema"
      ],
      "type": "object"
    },
    "events": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/validationEvent"
          },
          {
            "$ref": "#/$defs/executionEvent"
          }
        ]
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "ferris.pulse-51-diagnostic-executor-public-return/v1"
    }
  },
  "required": [
    "catalog",
    "events",
    "schema"
  ],
  "type": "object"
}
